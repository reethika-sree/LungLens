# VoiceCare PHC Backend Environment Configuration Template
# Copy this file to .env and customize as needed:
#   copy .env.example .env

# Application Mode
DEBUG=False

# MongoDB Configuration
# Option A: Local MongoDB (Default)
MONGODB_URL=mongodb://localhost:27017/voicecare
MONGODB_DB_NAME=voicecare

# Option B: MongoDB Atlas (Cloud Cluster)
# MONGODB_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/voicecare

# JWT Authentication
JWT_SECRET_KEY=voicecare-phc-super-secret-jwt-key-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# External Voice API Service (GPU Colab ngrok endpoint for Whisper/IndicASR)
# Example: VOICE_API_URL=https://your-ngrok-url.ngrok-free.app
VOICE_API_URL=
